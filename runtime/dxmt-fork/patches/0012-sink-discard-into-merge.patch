diff --git b/src/airconv/transforms/sink_discard_into_merge.cpp b/src/airconv/transforms/sink_discard_into_merge.cpp
new file mode 100644
index 0000000..02dc332
--- /dev/null
+++ b/src/airconv/transforms/sink_discard_into_merge.cpp
@@ -0,0 +1,91 @@
+#include "sink_discard_into_merge.hpp"
+#include "llvm/ADT/STLExtras.h"
+#include "llvm/ADT/SmallVector.h"
+#include "llvm/IR/BasicBlock.h"
+#include "llvm/IR/CFG.h"
+#include "llvm/IR/Function.h"
+#include "llvm/IR/Instructions.h"
+
+using namespace llvm;
+
+namespace llvm::air {
+
+static bool
+isDiscard(const Instruction &I) {
+  auto *Call = dyn_cast<CallInst>(&I);
+  if (!Call)
+    return false;
+  auto *Callee = Call->getCalledFunction();
+  return Callee && Callee->getName() == "air.discard_fragment";
+}
+
+// Appends the discards of Pred that one discard at the start of Merge can
+// replace. Pred must branch only to Merge, and nothing after a discard may have
+// a side effect: then running the discard a few instructions later changes
+// nothing observable. Returns false, leaving Out as it was, when Pred has no
+// discard or has one that has to stay where it is.
+static bool
+sinkableDiscards(BasicBlock *Pred, BasicBlock *Merge, SmallVectorImpl<CallInst *> &Out) {
+  auto *Branch = dyn_cast<BranchInst>(Pred->getTerminator());
+  if (!Branch || Branch->isConditional() || Pred == Merge)
+    return false;
+  const size_t Before = Out.size();
+  bool InPureTail = true;
+  for (Instruction &I : reverse(*Pred)) {
+    if (I.isTerminator())
+      continue;
+    if (isDiscard(I)) {
+      if (!InPureTail) {
+        Out.truncate(Before);
+        return false;
+      }
+      Out.push_back(cast<CallInst>(&I));
+    } else if (InPureTail && I.mayHaveSideEffects()) {
+      InPureTail = false;
+    }
+  }
+  return Out.size() > Before;
+}
+
+// Apple's GPU compiler (MTLCompilerService, AGX backend) crashes in
+// PHINode::removeIncomingValue on a block with PHI nodes when every predecessor
+// discards the fragment. Two DXBC discards with opposite conditions optimize
+// into that shape, and the crash also fails every other pipeline that the
+// service is compiling at that moment. The discard does not have to be the last
+// instruction of the predecessor for the crash to happen.
+//
+// Every path into such a block has just discarded, so one discard at the start
+// of the block is equivalent and leaves none in the predecessors. The moved
+// discard can give a later merge block the same shape, hence the fixpoint; each
+// round removes at least one discard, so it terminates.
+PreservedAnalyses
+SinkDiscardIntoMergePass::run(Function &F, FunctionAnalysisManager &AM) {
+  bool Changed = false;
+  bool Progress = true;
+  while (Progress) {
+    Progress = false;
+    for (BasicBlock &Merge : F) {
+      if (!isa<PHINode>(Merge.front()))
+        continue;
+      SmallVector<CallInst *, 4> Discards;
+      unsigned Preds = 0;
+      bool AllDiscard = true;
+      for (BasicBlock *Pred : predecessors(&Merge)) {
+        ++Preds;
+        if (!sinkableDiscards(Pred, &Merge, Discards)) {
+          AllDiscard = false;
+          break;
+        }
+      }
+      if (!AllDiscard || Preds < 2)
+        continue;
+      Discards.front()->moveBefore(&*Merge.getFirstInsertionPt());
+      for (CallInst *Duplicate : drop_begin(Discards))
+        Duplicate->eraseFromParent();
+      Progress = Changed = true;
+    }
+  }
+  return Changed ? PreservedAnalyses::none() : PreservedAnalyses::all();
+}
+
+} // namespace llvm::air
