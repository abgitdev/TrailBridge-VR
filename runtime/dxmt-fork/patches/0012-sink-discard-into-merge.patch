+#pragma once
+#include "llvm/IR/PassManager.h"
+
+namespace llvm::air {
+class SinkDiscardIntoMergePass : public PassInfoMixin<SinkDiscardIntoMergePass> {
+public:
+  PreservedAnalyses run(Function &F, FunctionAnalysisManager &AM);
+};
+} // namespace llvm::air
