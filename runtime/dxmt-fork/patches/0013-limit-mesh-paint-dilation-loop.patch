 #include "ftl.hpp"
 
+// Stops the shader's first counted loop after one iteration. The loop must
+// keep the shape `br (fcmp ult counter, bound), body, exit`; anything else
+// is left as it is.
+static void
+limitFirstLoop(llvm::Module &M, const char *FunctionName) {
+  using namespace llvm;
+  Function *F = M.getFunction(FunctionName);
+  if (!F)
+    return;
+  for (BasicBlock &BB : *F) {
+    if (!BB.getName().startswith("loop_entrance"))
+      continue;
+    auto *Branch = dyn_cast<BranchInst>(BB.getTerminator());
+    if (!Branch || !Branch->isConditional() ||
+        !Branch->getSuccessor(0)->getName().startswith("after_breakc"))
+      continue;
+    auto *Compare = dyn_cast<FCmpInst>(Branch->getCondition());
+    if (!Compare || Compare->getPredicate() != CmpInst::FCMP_ULT)
+      continue;
+    IRBuilder<> Builder(Branch);
+    Builder.setFastMathFlags(Compare->getFastMathFlags());
+    Value *Counter = Compare->getOperand(0);
+    Value *First = Builder.CreateFCmp(
+        CmpInst::FCMP_ULT, Counter, ConstantFP::get(Counter->getType(), 1.0)
+    );
+    Branch->setCondition(Builder.CreateAnd(Compare, First));
+    return;
+  }
+}
