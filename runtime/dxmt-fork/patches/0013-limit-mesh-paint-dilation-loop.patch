+// A pixel shader that fills empty texels from the nearest painted one, in a
+// loop with no early exit. Run several times in a row, it costs more than a
+// whole frame on Apple GPUs. One step of the search keeps the result intact.
+static bool
+limitsFirstLoop(ManagedShader shader) {
+  return shader->sha1().string() == "92fe2364dd2d1027b7b54d0f2da69ca7c24c4368";
+}
+
 template <>
 std::unique_ptr<CompiledShader>
 CreateVariantShader(MTLD3D11Device *pDevice, ManagedShader shader,
                     ShaderVariantPixel variant) {
+  const bool limit_first_loop = limitsFirstLoop(shader);
   Sha1HashState h;
   h.update(getGlobalShaderFlag());
   h.update(variant.sample_mask);
   h.update(variant.unorm_output_reg_mask);
   h.update(variant.dual_source_blending);
   h.update(variant.disable_depth_output);
+  // Only this shader gets a new cache key; every other entry stays valid.
+  if (limit_first_loop)
+    h.update(SM50_SHADER_FLAG_LIMIT_FIRST_LOOP);
   auto variant_digest = h.final();
   std::string func_name = "ps_" + shader->sha1().string().substr(0, 8) + "_" + variant_digest.string();
 
   auto proc = [=](const char *func_name, SM50_SHADER_COMMON_DATA *common) -> sm50_bitcode_t  {
+    SM50_SHADER_COMMON_DATA limited_common;
+    if (limit_first_loop) {
+      limited_common = *common;
+      limited_common.flags = (SM50_SHADER_FLAG)(common->flags | SM50_SHADER_FLAG_LIMIT_FIRST_LOOP);
+      common = &limited_common;
+    }
     SM50_SHADER_PSO_PIXEL_SHADER_DATA data;
     data.type = SM50_SHADER_PSO_PIXEL_SHADER;
     data.next = common;
