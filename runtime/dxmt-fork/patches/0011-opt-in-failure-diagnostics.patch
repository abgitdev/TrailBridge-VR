diff --git a/src/winemetal/unix/basalt_diagnostics.h b/src/winemetal/unix/basalt_diagnostics.h
new file mode 100644
--- /dev/null
+++ b/src/winemetal/unix/basalt_diagnostics.h
@@ -0,0 +1,112 @@
+/* Optional local diagnostics for the MIT-licensed DXMT v0.80 fork.
+ * Copyright (c) 2026 TrailBridge VR contributors. MIT license.
+ */
+#pragma once
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <objc/runtime.h>
+
+static bool
+basalt_diagnostics_enabled(void) {
+  const char *value = getenv("DXMT_BASALT_DIAGNOSTICS");
+  return value && !strcmp(value, "1");
+}
+
+/* Never fall back to the working directory, HOME or the system temp directory.
+ * Reject symlinks in the output path. Each process gets a fresh private run dir.
+ */
+static NSString *
+basalt_diagnostics_directory(void) {
+  static NSString *directory;
+  static dispatch_once_t once;
+  dispatch_once(&once, ^{
+    const char *root = getenv("BASALT_REPO_ROOT");
+    if (!basalt_diagnostics_enabled() || !root || root[0] != '/')
+      return;
+    NSString *base = [[NSString stringWithUTF8String:root] stringByAppendingPathComponent:@".local/diagnostics"];
+    base = [base stringByStandardizingPath];
+    if (![[base stringByResolvingSymlinksInPath] isEqualToString:base])
+      return;
+    NSString *path = [base stringByAppendingPathComponent:
+        [NSString stringWithFormat:@"dxmt-%d-%@", getpid(), [[NSUUID UUID] UUIDString]]];
+    if ([[NSFileManager defaultManager] createDirectoryAtPath:path withIntermediateDirectories:YES
+          attributes:@{NSFilePosixPermissions: @0700} error:nil])
+      directory = [path copy];
+  });
+  return directory;
+}
+
+static char basalt_air_data_key;
+
+/* Retain the exact cached or freshly generated AIR-containing metallib only
+ * while diagnostics are enabled; ordinary runs have no extra copies or I/O.
+ */
+static void
+basalt_attach_library_data(id library, dispatch_data_t data) {
+  if (!basalt_diagnostics_directory() || !library)
+    return;
+  const void *bytes;
+  size_t size;
+  dispatch_data_t mapped = dispatch_data_create_map(data, &bytes, &size);
+  if (mapped) {
+    NSData *copy = [NSData dataWithBytes:bytes length:size];
+    objc_setAssociatedObject(library, &basalt_air_data_key, copy, OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+    dispatch_release(mapped);
+  }
+}
+
+static void
+basalt_attach_function_data(id function, id library) {
+  if (!basalt_diagnostics_directory() || !function)
+    return;
+  objc_setAssociatedObject(function, &basalt_air_data_key,
+      objc_getAssociatedObject(library, &basalt_air_data_key), OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+}
+
+static void
+basalt_dump_pipeline_failure(id descriptor, NSError *error, id<MTLFunction> const *functions, size_t count) {
+  NSString *directory = basalt_diagnostics_directory();
+  if (!directory)
+    return;
+  NSString *stem = [@"pipeline-" stringByAppendingString:[[NSUUID UUID] UUIDString]];
+  NSMutableString *text = [NSMutableString stringWithFormat:@"%@\n%@\n", error, descriptor];
+  for (size_t i = 0; i < count; i++) {
+    if (!functions[i])
+      continue;
+    NSData *data = objc_getAssociatedObject(functions[i], &basalt_air_data_key);
+    NSString *name = [NSString stringWithFormat:@"%@-shader-%zu.metallib", stem, i];
+    BOOL saved = data && [data writeToFile:[directory stringByAppendingPathComponent:name] atomically:YES];
+    [text appendFormat:@"\nshader[%zu]: %@; AIR file: %@\n", i, [functions[i] name], saved ? name : @"unavailable"];
+  }
+  [text writeToFile:[directory stringByAppendingPathComponent:[stem stringByAppendingString:@".txt"]]
+        atomically:YES encoding:NSUTF8StringEncoding error:nil];
+}
+
+static void
+basalt_label_encoder(id<MTLCommandEncoder> encoder, id<MTLCommandBuffer> buffer, NSString *kind) {
+  if (!basalt_diagnostics_directory())
+    return;
+  static atomic_uint_fast64_t sequence;
+  encoder.label = [NSString stringWithFormat:@"%@ / %@ %llu", buffer.label, kind,
+      (unsigned long long)atomic_fetch_add(&sequence, 1)];
+}
+
+static void
+basalt_dump_first_gpu_error(id<MTLCommandBuffer> buffer) {
+  if (!basalt_diagnostics_directory())
+    return;
+  static dispatch_once_t once;
+  dispatch_once(&once, ^{
+    NSError *error = buffer.error;
+    NSMutableString *text = [NSMutableString stringWithFormat:@"label: %@\n%@\n%@\n",
+        buffer.label, buffer, error];
+    fprintf(stderr, "err:   Basalt first GPU error: command buffer=%p label=%s: %s\n",
+        (void *)buffer, [buffer.label UTF8String], [[error description] UTF8String]);
+    for (id<MTLCommandBufferEncoderInfo> info in error.userInfo[MTLCommandBufferEncoderInfoErrorKey])
+      [text appendFormat:@"encoder: %@; state: %ld; signposts: %@\n",
+          info.label, (long)info.errorState, info.debugSignposts];
+    [text writeToFile:[basalt_diagnostics_directory() stringByAppendingPathComponent:@"first-gpu-error.txt"]
+          atomically:YES encoding:NSUTF8StringEncoding error:nil];
+  });
+}
