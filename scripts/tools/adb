#!/bin/zsh
set -euo pipefail

readonly repo_dir=${0:A:h:h:h}
if [[ ${BASALT_REPO_ROOT:-} != "$repo_dir" ]]; then
    exec "$repo_dir/scripts/trailbridge-dev.zsh" "$0" "$@"
fi
readonly developer_adb="$repo_dir/.local/tools/platform-tools/adb"
readonly data_dir=${BASALT_DATA_DIR:-$repo_dir/.local/data}
readonly managed_adb="$data_dir/Tools/platform-tools/adb"
if [[ -x "$developer_adb" && -f "$HOME/.android/adbkey" ]]; then
    # Developer copy. Reuse this Mac's existing host authorization read-only;
    # the sandbox below prevents key generation or writes to the user's
    # Android directory. Never change HOME or the other ADB server here.
    readonly adb_binary=$developer_adb
    export ANDROID_ADB_LOG_PATH="$repo_dir/.local/diagnostics/adb-server.log"
    export ADB_SERVER_SOCKET=tcp:localhost:5038
elif [[ -x "$managed_adb" ]]; then
    # The copy that the Headset page downloads, with the app's own settings
    # (AlvrADBEnvironment). ADB 37 ignores ANDROID_USER_HOME and keeps its key
    # in $HOME/.android, so HOME points into the data folder for this process
    # only. The key is created there and never in the Mac profile. The data
    # folder may be on any disk: internal, external or network storage.
    readonly adb_binary=$managed_adb
    readonly android_home="$data_dir/Tools/Android"
    mkdir -p "$android_home" 2>/dev/null || {
        print -u2 "Cannot write to the data folder $data_dir. Is its disk connected?"
        exit 1
    }
    export HOME="$android_home" ANDROID_USER_HOME="$android_home"
    export ANDROID_ADB_LOG_PATH="$data_dir/Tools/adb.log"
    export ADB_SERVER_SOCKET=tcp:localhost:5039
else
    # The first sentence is AlvrWiredFailure.adbMissing, which the app recognizes.
    print -u2 "Could not find adb; open Headset in TrailBridge and choose Get Android Platform Tools." \
        "In Russian the button is «Скачать Android Platform Tools…»."
    exit 1
fi
export ADB_MDNS_AUTO_CONNECT=0
unset ADB_VENDOR_KEYS ANDROID_ADB_SERVER_ADDRESS ANDROID_ADB_SERVER_PORT
if [[ $adb_binary == "$managed_adb" ]]; then
    # The downloaded copy may write inside this repository and the data folder.
    exec /usr/bin/sandbox-exec -D "WORKSPACE=$repo_dir" -D "DATA=${data_dir:A}" -p '
(version 1)
(allow default)
(deny file-write*)
(allow file-write* (subpath (param "WORKSPACE")) (subpath (param "DATA")) (literal "/dev/null") (literal "/dev/tty"))
' "$adb_binary" "$@"
fi
# The developer copy may write only inside this repository.
exec /usr/bin/sandbox-exec -D "WORKSPACE=$repo_dir" -p '
(version 1)
(allow default)
(deny file-write*)
(allow file-write* (subpath (param "WORKSPACE")) (literal "/dev/null") (literal "/dev/tty"))
' "$adb_binary" "$@"
